# Copy to keystore.properties, then fill in the values for *your* keystore.
# Never commit keystore.properties or the .jks file itself.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore my-release.jks -alias my-key ^
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=my-release.jks
storePassword=change-me
keyAlias=my-key
keyPassword=change-me
