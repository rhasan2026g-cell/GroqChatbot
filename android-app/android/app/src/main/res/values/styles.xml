<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0F131A</item>
        <item name="colorPrimaryDark">#0F131A</item>
        <item name="colorAccent">#4C8DFF</item>
        <item name="android:windowBackground">#0F131A</item>
        <item name="android:statusBarColor">#0F131A</item>
        <item name="android:navigationBarColor">#0F131A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Android 12+ system splash: brand colour instead of a white flash. -->
        <item name="android:windowSplashScreenBackground">#0F131A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!-- Kept so the stock splash theme keeps resolving if it is ever referenced. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">#0F131A</item>
        <item name="android:navigationBarColor">#0F131A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="windowSplashScreenBackground">#0F131A</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
