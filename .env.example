# Copy this file to .env and paste your own keys.
# Get Groq key free at https://console.groq.com/keys
# Get HuggingFace key free at https://huggingface.co/settings/tokens
# Get Replicate key at https://replicate.com/account/api-tokens

# Required - Core LLM
GROQ_API_KEY=

# Image/Video/Music Generation Providers
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
FAL_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Agent Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_ENABLED=true
RAG_ENABLED=true
AGENT_MODE=true
MAX_MEMORY_RESULTS=10
MAX_RAG_RESULTS=3
GENERATION_OUTPUT_DIR=generated
