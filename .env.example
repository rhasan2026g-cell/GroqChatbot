# Copy this file to .env and paste your own keys.
# Get Groq key free at https://console.groq.com/keys
# Get HuggingFace key free at https://huggingface.co/settings/tokens

# Required
GROQ_API_KEY=

# Optional - For Image/Video/Music Generation
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
OPENAI_API_KEY=

# Optional - Agent Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_ENABLED=true
RAG_ENABLED=true
AGENT_MODE=true
MAX_MEMORY_RESULTS=10
MAX_RAG_RESULTS=3
